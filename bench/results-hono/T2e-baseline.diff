+/**
+ * @module
+ * Health Middleware for Hono.
+ */
+import type { MiddlewareHandler } from '../../types'
+
+type HealthOptions = {
+  path?: string
+  status?: 'ok' | 'degraded'
+}
+
+export const health = (options?: HealthOptions): MiddlewareHandler => {
+  return async function health(c, next) {
+    if (c.req.path === (options?.path ?? '/healthz')) {
+      return c.json({ status: options?.status ?? 'ok' }, 200)
+    }
+    await next()
+  }
+}
