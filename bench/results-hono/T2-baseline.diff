+/**
+ * @module
+ * Body Cap Middleware for Hono.
+ */
+
+import { HTTPException } from '../../http-exception'
+import type { MiddlewareHandler } from '../../types'
+
+export const bodyCap = (options: { maxBytes: number }): MiddlewareHandler => {
+  return async function bodyCap(c, next) {
+    const contentLength = c.req.raw.headers.get('Content-Length')
+    if (contentLength !== null && parseInt(contentLength, 10) > options.maxBytes) {
+      throw new HTTPException(413, { message: 'Body too large' })
+    }
+    await next()
+  }
+}
