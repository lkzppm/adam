{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "timeout": 120000,
          "command": "mkdir -p \"${CLAUDE_PLUGIN_DATA}\" && (diff -q \"${CLAUDE_PLUGIN_ROOT}/package.json\" \"${CLAUDE_PLUGIN_DATA}/package.json\" >/dev/null 2>&1 || (cd \"${CLAUDE_PLUGIN_DATA}\" && cp \"${CLAUDE_PLUGIN_ROOT}/package.json\" . && npm install --silent --no-audit --no-fund) || rm -f \"${CLAUDE_PLUGIN_DATA}/package.json\")"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "timeout": 5,
          "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/graph-context.js"
        }
      ]
    }
  ]
}
