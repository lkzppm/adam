+import type { MiddlewareHandler } from '../../types'
+
+type Options = {
+  path?: string
+  status?: 'ok' | 'degraded'
+}
+
+export const health = (options?: Options): MiddlewareHandler => {
+  const path = options?.path ?? '/healthz'
+  const status = options?.status ?? 'ok'
+  return async (c, next) => {
+    if (c.req.path === path) {
+      return c.json({ status }, 200)
+    }
+    await next()
+  }
+}
