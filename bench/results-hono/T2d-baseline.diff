+/**
+ * @module
+ * If-None-Match Middleware for Hono.
+ */
+
+import type { MiddlewareHandler } from '../../types'
+
+/**
+ * If-None-Match Middleware for Hono.
+ *
+ * After the response is produced, if the response has an `ETag` header and the
+ * request's `If-None-Match` header matches it exactly, the response is replaced
+ * with a 304 Not Modified with an empty body, preserving the `ETag` header.
+ *
+ * @returns {MiddlewareHandler} The middleware handler function.
+ */
+export const ifNoneMatch = (): MiddlewareHandler => {
+  return async function ifNoneMatch(c, next) {
+    await next()
+
+    const etag = c.res.headers.get('ETag')
+    if (!etag) {
+      return
+    }
+
+    const ifNoneMatchHeader = c.req.header('If-None-Match')
+    if (ifNoneMatchHeader === etag) {
+      c.res = new Response(null, {
+        status: 304,
+        statusText: 'Not Modified',
+        headers: { ETag: etag },
+      })
+    }
+  }
+}
