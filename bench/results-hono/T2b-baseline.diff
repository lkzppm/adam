+/**
+ * @module
+ * Request Time Middleware for Hono.
+ */
+import type { MiddlewareHandler } from '../../types'
+
+/**
+ * Request Time Middleware for Hono.
+ *
+ * @returns {MiddlewareHandler} The middleware handler function.
+ *
+ * @example
+ * ```ts
+ * import { requestTime } from 'hono/request-time'
+ *
+ * const app = new Hono()
+ *
+ * app.use(requestTime())
+ * ```
+ */
+export const requestTime = (): MiddlewareHandler => {
+  return async function requestTime(c, next) {
+    const start = Date.now()
+    await next()
+    c.res.headers.set('X-Response-Time-Ms', String(Date.now() - start))
+  }
+}
