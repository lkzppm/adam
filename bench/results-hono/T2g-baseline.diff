+import type { Context } from '../../context'
+
+export const getBearerToken = (c: Context): string | null => {
+  const header = c.req.raw.headers.get('Authorization')
+  if (!header) {
+    return null
+  }
+  const match = header.match(/^[Bb]earer\s+(.+)$/i)
+  return match ? match[1] : null
+}
