+/**
+ * @module
+ * Bearer Token Helper for Hono.
+ */
+
+import type { Context } from '../../context'
+
+export const getBearerToken = (c: Context): string | null => {
+  const header = c.req.header('Authorization')
+  if (!header) {
+    return null
+  }
+  const match = header.match(/^[Bb]earer\s+(.+)$/)
+  if (!match) {
+    return null
+  }
+  return match[1]
+}
