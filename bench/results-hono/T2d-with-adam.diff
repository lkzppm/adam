@@ -0,0 +1,14 @@
+import type { MiddlewareHandler } from '../../types'
+
+export const ifNoneMatch = (): MiddlewareHandler => {
+  return async (c, next) => {
+    await next()
+    const etag = c.res.headers.get('ETag')
+    if (etag && c.req.header('If-None-Match') === etag) {
+      c.res = new Response(null, {
+        status: 304,
+        headers: { ETag: etag },
+      })
+    }
+  }
+}
